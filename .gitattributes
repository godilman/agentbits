# Keep LF everywhere (tests and tooling read sources line by line; Windows checkouts would otherwise get CRLF).
* text=auto eol=lf

# Binary assets
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.pdf binary
*.zip binary
*.xlsx binary
*.docx binary
*.pptx binary
*.doc binary
*.xls binary
*.ppt binary
*.gz binary
*.wasm binary
*.traineddata binary
